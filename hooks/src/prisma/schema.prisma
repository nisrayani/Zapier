generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
    id        Int      @id @default(autoincrement())
    name      String
    email     String   @unique
    password String
    zaps      Zap[]
}

model Zap{
    id        Int      @id @default(autoincrement())
    name      String
    userId    Int
    user      User     @relation(fields: [userId], references: [id])
    triggers  Trigger[]
}

model Trigger{
    id        Int      @id @default(autoincrement())
    type TriggerType @relation(fields: [typeId], references: [id])
    typeId    Int
    zapId     Int
    zap       Zap      @relation(fields: [zapId], references: [id])
}

model TriggerType{
    id        Int      @id @default(autoincrement())
    name      String
    triggers  Trigger[]
}