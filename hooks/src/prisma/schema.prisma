generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
    id        Int      @id @default(autoincrement())
    name      String
    email     String   @unique
    password String
    zaps      Zap[]
}

model Zap{
    id        Int      @id @default(autoincrement())
    name      String
    userId    Int
    user      User     @relation(fields: [userId], references: [id])
    triggers  Trigger[]
    actions   Action[]
    zapRuns  ZapRun[]
}

model Trigger{
    id        Int      @id @default(autoincrement())
    type TriggerType @relation(fields: [typeId], references: [id])
    typeId    Int
    zapId     Int
    zap       Zap      @relation(fields: [zapId], references: [id])
}

model TriggerType{
    id        Int      @id @default(autoincrement())
    name      String
    triggers  Trigger[]
}

model Action{
    id        Int      @id @default(autoincrement())
    type ActionType @relation(fields: [typeId], references: [id])
    typeId    Int
    zapId     Int
    zap       Zap      @relation(fields: [zapId], references: [id])
}
model ActionType{
    id        Int      @id @default(autoincrement())
    name      String
    actions   Action[]
}

model ZapRun{
    id        Int      @id @default(autoincrement())
    zapId     Int
    zap       Zap      @relation(fields: [zapId], references: [id])
    status    Status?
    metadata  Json?
    createdAt DateTime @default(now())
    zapOutbox ZapOutbox[]
}

model ZapOutbox{
    id        Int      @id @default(autoincrement())
    zapRunId  Int
    zapRun    ZapRun   @relation(fields: [zapRunId], references: [id])
    status    Status?
    createdAt DateTime @default(now())
}

enum Status{
    PENDING
    COMPLETED
    FAILED
}