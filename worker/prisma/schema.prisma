generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
    id        String   @id @default(uuid())
    name      String
    email     String   @unique
    password String
    zaps      Zap[]
}

model Zap{
    id        String   @id @default(uuid())
    name      String
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    trigger  Trigger? 
    actions   Action[]
    zapRuns  ZapRun[]
}

model Trigger{
    id        String   @id @default(uuid())
    type      TriggerType @relation(fields: [typeId], references: [id])
    typeId    String
    zapId     String   @unique
    zap       Zap      @relation(fields: [zapId], references: [id])
}

model TriggerType{
    id        String   @id @default(uuid())
    name      String
    triggers  Trigger[]
}

model Action{
    id        String   @id @default(uuid())
    type ActionType @relation(fields: [typeId], references: [id])
    typeId    String
    zapId     String
    zap       Zap      @relation(fields: [zapId], references: [id])
    sortingOrder Int @default(0)
}
model ActionType{
    id        String   @id @default(uuid())
    name      String
    actions   Action[]
}

model ZapRun{
    id        String   @id @default(uuid())
    zapId     String
    zap       Zap      @relation(fields: [zapId], references: [id])
    status    Status?
    metadata  Json?
    createdAt DateTime @default(now())
    zapOutbox ZapOutbox[]
}

model ZapOutbox{
    id        String   @id @default(uuid())
    zapRunId  String
    zapRun    ZapRun   @relation(fields: [zapRunId], references: [id])
    status    Status?
    createdAt DateTime @default(now())
}

enum Status{
    PENDING
    COMPLETED
    FAILED
    PUBLISHED
}